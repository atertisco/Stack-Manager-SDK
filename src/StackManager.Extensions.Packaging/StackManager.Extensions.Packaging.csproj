<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StackManager.Extensions.Hosting</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Synsoft Solutions</Authors>
    <Copyright>Copyright (c) 2026, Synsoft Solutions</Copyright>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <Description>Makes and checks Stack Manager extension packages (.smx). Preview.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StackManager.Extensions.Sdk\StackManager.Extensions.Sdk.csproj" />
  </ItemGroup>

</Project>
